# ==============================================================================
# ScholarSAT - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: User AI keys (OpenAI, Anthropic, Gemini, DeepSeek) are NOT configured
# here because ScholarSAT uses a BYOK (Bring Your Own Key) architecture where
# keys are stored client-side in the user's browser for privacy and $0 server cost!
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Docker local default)
DATABASE_URL="postgresql://scholarsat:scholarsat_dev@localhost:5432/scholarsat_db?schema=public"

# Redis Cache (Local Docker default)
REDIS_URL="redis://localhost:6379"

# Authentication (NextAuth / Auth.js)
# In production, generate a secure random 32-byte secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="scholarsat_development_super_secret_key_change_in_prod"

# Desmos Graphing Calculator API Key (Public demo key for local dev)
# For production domain whitelist, register at https://www.desmos.com/api
NEXT_PUBLIC_DESMOS_API_KEY="dcb31709b452b1cf9dc26972add0fda6"

# Optional: OAuth Providers (Leave empty for guest/demo mode)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Email Magic Link (SMTP)
# EMAIL_SERVER_HOST="smtp.mailtrap.io"
# EMAIL_SERVER_PORT=2525
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM="no-reply@scholarsat.org"

# Contabo Production Deployment Domain (used by Caddy in docker-compose.prod.yml)
DOMAIN_NAME="scholarsat.org"
